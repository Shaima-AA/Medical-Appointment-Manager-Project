<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <title>All Appointments</title>
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container appointments-container">
    <h1 class="page-title">All Appointments</h1>

    <div class="appointments-list">
      <% for (let oneAppointment of appointments) { %>
        <% if (user._id == oneAppointment.user) { %>

          <div class="appointment-card">
            

            <div class="appointment-info">
              <h2>Appointment with Dr. <%= oneAppointment.Doctor?.Name %></h2>
              <p>by <%= oneAppointment.Patient %></p>
            </div>

            <a href="/Appointments/<%= oneAppointment._id %>" class="appointment-btn">View Details</a>
          </div>

        <% } %>
      <% } %>
    </div>
  </div>
</body>
</html>