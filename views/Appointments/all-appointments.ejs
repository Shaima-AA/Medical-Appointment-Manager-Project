<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
        <%- include('../partials/navbar') %>

    <h1>All Appointments</h1>
     

  

    <% for(let oneAppointment of appointments) { %>
     <% if (user._id == oneAppointment.user){ %>

       <p>Appointment with Dr. <%= oneAppointment.Doctor?.Name %> by <%= oneAppointment.Patient  %></p>
       <a href="/Appointments/<%= oneAppointment._id %>">View Details</a>


        <% } %>
          <% } %>










</body>
</html>