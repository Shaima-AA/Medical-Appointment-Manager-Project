
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="/css/style.css">    <title>Create Appointment</title>
</head>

<body class="booking-page">
    <%- include('../partials/navbar') %>

        <h1 id="booking-title">Book an Appointment</h1>

        <form class="booking-form" action="/appointments/new/<%= doctor._id %>" method="post">
            <label for="Patient">Patient:</label>
            <input type="text" id="Patient" name="Patient"> <br><br><br>

            <label for="Doctor">Doctor:</label>
            <input type="text" id="Doctor" name="Doctor" value="Dr. <%= doctor.Name %>" disabled><br><br><br>

            <label for="Date">Date:</label>
            <input type="date" id="Date" name="Date"><br><br><br>
            Time: <select name="time" id="time">Time:
                <% for(let slot of availableSlots){ %>
                    <option value="<%= slot._id %>">
                        <%= slot.time %>
                    </option>
                    <% } %>
            </select> <br><br><br>

            <label for="Reason">Reason:</label>
            <input type="text" id="Reason" name="Reason"><br><br><br>

            <button class="booking-btn">Book Appointment</button>
        </form>

</body>

</html>
