<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">

    <title>Appointment Details</title>
</head>

<body class="details-page">
    <%- include('../partials/navbar') %>

        <h1 id="details-title">Appointment Details</h1>

        <p id="detail-patient" class="detail-line">Patient: <%= appointments.Patient %>
        </p>
        <p id="detail-doctor" class="detail-line">With Dr. <%= appointments.Doctor?.Name %>
        </p>
        <p id="detail-date" class="detail-line">Date: <%= appointments.Date %>
        </p>
        <p id="detail-time" class="detail-line">Time: <%= appointments.time?.time %></p>
        <p id="detail-reason" class="detail-line">Reason: <%= appointments.Reason %>
        </p>


        <a class="edit-link" href="/appointments/<%= appointments._id %>/edit">
            <button class="edit-btn">Edit Appointment</button>
        </a>    <br>   <br>   

    
      


<form class="delete-form"
      action="/appointments/<%= appointments._id %>?_method=DELETE"
      method="POST"
      onsubmit="return confirm('Delete this appointment? This cannot be undone.');">
    <button class="delete-btn" type="submit">Delete Appointment</button>
</form>

    </body>

</html>